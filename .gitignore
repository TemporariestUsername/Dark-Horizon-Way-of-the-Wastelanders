# Never commit source ROMs, emulator states, or raw extraction dumps.
*.smc
*.sfc
*.st
*.srm
roms/
dumps/

# Downloaded source data (Natural Earth etc.); rebuilt by tools/
data/raw/
__pycache__/

# Godot editor/import cache
.godot/
# Sim runner output (reports worth keeping are copied to docs/reports/)
tools/out/

# Playtest builds (tools/export.sh)
build/
build.txt
