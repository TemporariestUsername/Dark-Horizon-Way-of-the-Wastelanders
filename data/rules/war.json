{
 "_doc": "Gang war, Inindo's province war (docs/design/09-combat.md). Used by the M1 sim for conquest and by the game for sieges. Each hold's gang is {troops, arms, training, tags} in data/world/holds.json.",
 "troops_by_size": {"tiny": 8, "small": 20, "medium": 45, "large": 80, "huge": 150},
 "strength": "troops * (1 + arms/100) * (1 + training/100) * leader * walls",
 "leader": {"absent": 0.85, "present": 1.0, "player_per_fight_level": 0.02, "lieutenant_per_10_brawn": 0.02},
 "walls_defender_multiplier": [1.0, 1.25, 1.5],
 "rounds_max": 5,
 "losses_per_round": "enemy_strength * 0.08 * random(0.8, 1.2)",
 "morale": {"start": 100, "drop": "losses / troops * 120", "breaks_below": 30, "leader_killed": -30,
            "immune_tags": ["opened"]},
 "outcome": {"attacker_takes_hold_if": "defender breaks or is wiped out",
             "defender_holds_if": "attacker breaks or rounds run out",
             "conquest": "see rules/lean.json conquest", "survivor_recovery_per_month": 0.15},
 "tags": {
  "well-disciplined": {"training": 20, "breaks_below": 20},
  "savage": {"training": -10, "arms": 10},
  "mercenary": {"training": 10, "deserts_unpaid": true},
  "siege": {"vs_walls": 1.3},
  "fire": {"vs_walls": 1.2, "arms": 10},
  "defend-only": {"attacks": false},
  "opened": {"training": -20, "no_morale": true},
  "catchers": {"takes_prisoners": true},
  "mobile": {"no_walls": true}
 }
}
