; Engine configuration file.
; Dark Horizon: Way of the Wastelanders. Godot 4.4.
; The simulation lives in res://sim (headless), the playable M2 scenes in res://game,
; the runners and benches in res://tools.

config_version=5

[application]

config/name="Dark Horizon: Way of the Wastelanders"
config/features=PackedStringArray("4.4")
run/main_scene="res://game/main_menu.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
